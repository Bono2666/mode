<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action: Post Due Depreciation Entries Daily -->
        <record id="ir_cron_post_depreciation" model="ir.cron">
            <field name="name">Assets: Post Due Depreciation Entries</field>
            <field name="model_id" ref="model_assets_depreciation_line"/>
            <field name="state">code</field>
            <field name="code">model.action_post_due_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
