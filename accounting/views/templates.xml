<odoo>
    <data>

        <!-- Balance Sheet HTML Report Template -->
        <template id="report_balance_sheet_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <t t-set="data" t-value="docs.sorted(key=lambda r: (r.category_order, r.subcategory_order, r.account_code))"/>

                        <h3 class="text-center mt-2 mb-1"><strong>BALANCE SHEET</strong></h3>
                        <h5 class="text-center mb-3">
                            <t t-esc="context.get('date_as_of', '') or ''"/>
                        </h5>

                        <!-- ASSETS -->
                        <h5 class="mt-3 mb-1 p-2" style="background-color: #e9ecef;"><strong>ASSETS</strong></h5>

                        <!-- Current Asset -->
                        <t t-set="current_assets" t-value="data.filtered(lambda r: r.subcategory == 'Current Asset')"/>
                        <t t-if="current_assets">
                            <table class="table table-sm o_main_table mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-start" style="width: 16%;">Code</th>
                                        <th class="text-start" style="width: 54%;">Account</th>
                                        <th class="text-end" style="width: 30%;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="3" class="ps-4"><em><strong>Current Asset</strong></em></td>
                                    </tr>
                                    <t t-set="subtotal_ca" t-value="0.0"/>
                                    <t t-foreach="current_assets" t-as="line">
                                        <tr>
                                            <td class="ps-5"><t t-esc="line.account_code"/></td>
                                            <td class="ps-5"><t t-esc="line.account_name"/></td>
                                            <td class="text-end"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                        </tr>
                                        <t t-set="subtotal_ca" t-value="subtotal_ca + line.balance"/>
                                    </t>
                                    <tr class="border-top">
                                        <td colspan="2" class="ps-4"><strong>Total Current Asset</strong></td>
                                        <td class="text-end"><strong><t t-esc="'{:,.0f}'.format(subtotal_ca)"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- Fixed Asset -->
                        <t t-set="fixed_assets" t-value="data.filtered(lambda r: r.subcategory == 'Fixed Asset')"/>
                        <t t-if="fixed_assets">
                            <table class="table table-sm o_main_table mb-0">
                                <tbody>
                                    <tr>
                                        <td colspan="3" class="ps-4"><em><strong>Fixed Asset</strong></em></td>
                                    </tr>
                                    <t t-set="subtotal_fa" t-value="0.0"/>
                                    <t t-foreach="fixed_assets" t-as="line">
                                        <tr>
                                            <td class="ps-5" style="width: 16%;"><t t-esc="line.account_code"/></td>
                                            <td class="ps-5" style="width: 54%;"><t t-esc="line.account_name"/></td>
                                            <td class="text-end" style="width: 30%;"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                        </tr>
                                        <t t-set="subtotal_fa" t-value="subtotal_fa + line.balance"/>
                                    </t>
                                    <tr class="border-top">
                                        <td colspan="2" class="ps-4"><strong>Total Fixed Asset</strong></td>
                                        <td class="text-end"><strong><t t-esc="'{:,.0f}'.format(subtotal_fa)"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-set="total_assets" t-value="sum(data.filtered(lambda r: r.category == 'Assets').mapped('balance'))"/>
                        <table class="table table-sm o_main_table">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL ASSETS</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_assets)"/></strong></td>
                            </tr>
                        </table>

                        <!-- LIABILITIES -->
                        <h5 class="mt-3 mb-1 p-2" style="background-color: #e9ecef;"><strong>LIABILITIES</strong></h5>

                        <t t-set="liability_items" t-value="data.filtered(lambda r: r.category == 'Liabilities')"/>
                        <table class="table table-sm o_main_table mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 16%;">Code</th>
                                    <th class="text-start" style="width: 54%;">Account</th>
                                    <th class="text-end" style="width: 30%;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="liability_items" t-as="line">
                                    <tr>
                                        <td class="ps-4"><t t-esc="line.account_code"/></td>
                                        <td class="ps-4"><t t-esc="line.account_name"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="total_liabilities" t-value="sum(liability_items.mapped('balance'))"/>
                        <table class="table table-sm o_main_table">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL LIABILITIES</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_liabilities)"/></strong></td>
                            </tr>
                        </table>

                        <!-- EQUITY -->
                        <h5 class="mt-3 mb-1 p-2" style="background-color: #e9ecef;"><strong>EQUITY</strong></h5>

                        <t t-set="equity_items" t-value="data.filtered(lambda r: r.category == 'Equity')"/>
                        <table class="table table-sm o_main_table mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 16%;">Code</th>
                                    <th class="text-start" style="width: 54%;">Account</th>
                                    <th class="text-end" style="width: 30%;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="equity_items" t-as="line">
                                    <tr>
                                        <td class="ps-4"><t t-esc="line.account_code"/></td>
                                        <td class="ps-4"><t t-esc="line.account_name"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="total_equity" t-value="sum(equity_items.mapped('balance'))"/>
                        <table class="table table-sm o_main_table">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL EQUITY</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_equity)"/></strong></td>
                            </tr>
                        </table>

                        <t t-set="total_le" t-value="total_liabilities + total_equity"/>
                        <table class="table table-sm o_main_table mt-2">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL LIABILITIES + EQUITY</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_le)"/></strong></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </template>

        <!-- Profit And Loss HTML Report Template -->
        <template id="report_profit_loss_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <t t-set="data" t-value="docs.sorted(key=lambda r: (r.category_order, r.account_code))"/>

                        <h3 class="text-center mt-2 mb-1"><strong>PROFIT AND LOSS</strong></h3>
                        <h5 class="text-center mb-3">
                            <t t-if="context.get('date_from')">
                                <t t-esc="context.get('date_from')"/>
                            </t>
                            <t t-if="context.get('date_from') and context.get('date_to')"> - </t>
                            <t t-if="context.get('date_to')">
                                <t t-esc="context.get('date_to')"/>
                            </t>
                        </h5>

                        <!-- REVENUE -->
                        <h5 class="mt-3 mb-1 p-2" style="background-color: #e9ecef;"><strong>REVENUE</strong></h5>

                        <t t-set="revenue_items" t-value="data.filtered(lambda r: r.category == 'Revenue')"/>
                        <table class="table table-sm o_main_table mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 16%;">Code</th>
                                    <th class="text-start" style="width: 54%;">Account</th>
                                    <th class="text-end" style="width: 30%;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="revenue_items" t-as="line">
                                    <tr>
                                        <td class="ps-4"><t t-esc="line.account_code"/></td>
                                        <td class="ps-4"><t t-esc="line.account_name"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="total_revenue" t-value="sum(revenue_items.mapped('balance'))"/>
                        <table class="table table-sm o_main_table">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL REVENUE</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_revenue)"/></strong></td>
                            </tr>
                        </table>

                        <!-- EXPENSES -->
                        <h5 class="mt-3 mb-1 p-2" style="background-color: #e9ecef;"><strong>EXPENSES</strong></h5>

                        <t t-set="expense_items" t-value="data.filtered(lambda r: r.category == 'Expenses')"/>
                        <table class="table table-sm o_main_table mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 16%;">Code</th>
                                    <th class="text-start" style="width: 54%;">Account</th>
                                    <th class="text-end" style="width: 30%;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="expense_items" t-as="line">
                                    <tr>
                                        <td class="ps-4"><t t-esc="line.account_code"/></td>
                                        <td class="ps-4"><t t-esc="line.account_name"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.balance)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="total_expenses" t-value="sum(expense_items.mapped('balance'))"/>
                        <table class="table table-sm o_main_table">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;"><strong>TOTAL EXPENSES</strong></td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(total_expenses)"/></strong></td>
                            </tr>
                        </table>

                        <!-- NET PROFIT / LOSS -->
                        <t t-set="net_profit" t-value="total_revenue - total_expenses"/>
                        <table class="table table-sm o_main_table mt-2">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="2" style="width: 70%;">
                                    <strong>
                                        <t t-if="net_profit >= 0">NET PROFIT</t>
                                        <t t-else="">NET LOSS</t>
                                    </strong>
                                </td>
                                <td class="text-end" style="width: 30%;"><strong><t t-esc="'{:,.0f}'.format(abs(net_profit))"/></strong></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </template>

        <!-- Sales Order Profitability HTML Report Template -->
        <template id="report_sales_profitability_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <t t-set="data" t-value="docs.sorted(key=lambda r: (r.sale_order_date, r.sale_order_name), reverse=True)"/>

                        <h3 class="text-center mt-2 mb-1"><strong>SALES ORDER PROFITABILITY</strong></h3>
                        <h5 class="text-center mb-3">
                            <t t-if="context.get('date_from')">
                                <t t-esc="context.get('date_from')"/>
                            </t>
                            <t t-if="context.get('date_from') and context.get('date_to')"> - </t>
                            <t t-if="context.get('date_to')">
                                <t t-esc="context.get('date_to')"/>
                            </t>
                        </h5>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 12%;">SO Number</th>
                                    <th class="text-start" style="width: 14%;">Order Date</th>
                                    <th class="text-start" style="width: 16%;">Customer</th>
                                    <th class="text-end" style="width: 9%;">Revenue</th>
                                    <th class="text-end" style="width: 9%;">COGS</th>
                                    <th class="text-end" style="width: 9%;">Commission</th>
                                    <th class="text-end" style="width: 9%;">Supporting</th>
                                    <th class="text-end" style="width: 9%;">Total Cost</th>
                                    <th class="text-end" style="width: 9%;">Margin</th>
                                    <th class="text-end" style="width: 4%;">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data" t-as="line">
                                    <tr>
                                        <td class="ps-2"><t t-esc="line.sale_order_name"/></td>
                                        <td class="ps-2"><t t-esc="line.sale_order_date"/></td>
                                        <td class="ps-2"><t t-esc="line.customer_id.customer_name if line.customer_id else ''"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.total_revenue)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.cost_cogs)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.cost_commission)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.cost_supporting)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.total_cost)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.margin_amount)"/></td>
                                        <td class="text-end"><t t-esc="'{:,.1f}'.format(line.margin_percent)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-set="total_revenue" t-value="sum(data.mapped('total_revenue'))"/>
                        <t t-set="total_cost" t-value="sum(data.mapped('total_cost'))"/>
                        <t t-set="total_margin" t-value="sum(data.mapped('margin_amount'))"/>
                        <table class="table table-sm o_main_table mt-2">
                            <tr class="border-top border-bottom o_total">
                                <td colspan="3" style="width: 42%;"><strong>TOTAL</strong></td>
                                <td class="text-end" style="width: 9%;"><strong><t t-esc="'{:,.0f}'.format(total_revenue)"/></strong></td>
                                <td colspan="3"></td>
                                <td class="text-end" style="width: 9%;"><strong><t t-esc="'{:,.0f}'.format(total_cost)"/></strong></td>
                                <td class="text-end" style="width: 9%;"><strong><t t-esc="'{:,.0f}'.format(total_margin)"/></strong></td>
                                <td></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
