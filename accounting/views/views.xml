    <record model="ir.actions.act_window" id="action_fiscal_years">
      <field name="name">Fiscal Years</field>
      <field name="res_model">accounting.fiscal.year</field>
      <field name="view_mode">tree,form</field>
      <field name="target">main</field>
    </record>

    <record model="ir.actions.act_window" id="action_periods">
      <field name="name">Periods</field>
      <field name="res_model">accounting.period</field>
      <field name="view_mode">tree,form</field>
      <field name="target">main</field>
    </record>

    <record model="ir.actions.act_window" id="action_accounting_moves">
      <field name="name">Journal Entries</field>
      <field name="res_model">accounting.move</field>
      <field name="view_mode">tree,form</field>
      <field name="target">main</field>
    </record>

    <record model="ir.actions.act_window" id="action_bank_statements">
      <field name="name">Bank Statements</field>
      <field name="res_model">accounting.bank.statement</field>
      <field name="view_mode">tree,form</field>
      <field name="target">main</field>
    </record>

    <!-- Report actions -->
    <record model="ir.actions.act_window" id="action_trial_balance_wizard">
      <field name="name">Trial Balance</field>
      <field name="res_model">accounting.trial.balance.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <record model="ir.actions.act_window" id="action_general_ledger_wizard">
      <field name="name">General Ledger</field>
      <field name="res_model">accounting.general.ledger.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

    <record model="ir.actions.act_window" id="action_aged_receivable_wizard">
      <field name="name">Aged Receivable</field>
