      <field name="target">new</field>
    </record>

    <!-- ================================================================= -->
    <!-- MENU ITEMS                                                        -->
    <!-- ================================================================= -->

    <!-- Top-level Accounting menu -->
    <menuitem name="Accounting" id="accounting_root_menu" parent="general.menu_root" sequence="4"/>

    <!-- Transactions submenu -->
    <menuitem name="Transactions" id="menu_accounting_transactions_parent" parent="accounting_root_menu" sequence="1"/>
    <menuitem name="Journal Entries" id="menu_journal_entries_act" parent="menu_accounting_transactions_parent" action="action_accounting_moves" sequence="1"/>

    <!-- Banking submenu -->
    <menuitem name="Banking" id="menu_accounting_banking_parent" parent="accounting_root_menu" sequence="2"/>
