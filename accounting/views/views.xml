    <!-- Accounting config under main Configuration -->
    <menuitem name="Accounting" id="menu_accounting_config_parent" parent="general.menu_master_menu" sequence="4"/>
    <menuitem name="Chart of Accounts" id="menu_chart_of_accounts_act" parent="menu_accounting_config_parent" action="action_chart_of_accounts" sequence="1"/>
    <menuitem name="Account Types" id="menu_account_types_act" parent="menu_accounting_config_parent" action="action_account_types" sequence="2"/>
