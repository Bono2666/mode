<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Accounting Journals -->
        <record id="journal_sale" model="accounting.journal">
            <field name="name">Sales Journal</field>
            <field name="code">SALE</field>
            <field name="type">sale</field>
            <field name="default_credit_account_id" ref="account_400000"/>
        </record>
        <record id="journal_purchase" model="accounting.journal">
            <field name="name">Purchase Journal</field>
            <field name="code">PURC</field>
            <field name="type">purchase</field>
            <field name="default_debit_account_id" ref="account_500000"/>
        </record>
        <record id="journal_cash" model="accounting.journal">
            <field name="name">Cash Journal</field>
            <field name="code">CASH</field>
            <field name="type">cash</field>
            <field name="default_debit_account_id" ref="account_100000"/>
            <field name="default_credit_account_id" ref="account_100000"/>
        </record>
        <record id="journal_bank" model="accounting.journal">
            <field name="name">Bank Journal</field>
            <field name="code">BANK</field>
            <field name="type">bank</field>
            <field name="default_debit_account_id" ref="account_100000"/>
            <field name="default_credit_account_id" ref="account_100000"/>
        </record>
        <record id="journal_general" model="accounting.journal">
            <field name="name">Miscellaneous Journal</field>
            <field name="code">GENERAL</field>
            <field name="type">general</field>
        </record>
    </data>
</odoo>
