<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Journal Entry Number -->
        <record id="seq_accounting_move" model="ir.sequence">
            <field name="name">Journal Entry Sequence</field>
            <field name="code">accounting.move</field>
            <field name="prefix">JE</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Bank Statement Number -->
        <record id="seq_accounting_bank_statement" model="ir.sequence">
            <field name="name">Bank Statement Sequence</field>
            <field name="code">accounting.bank.statement</field>
            <field name="prefix">STM</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Account Code (fallback if code not manually entered) -->
        <record id="seq_accounting_account" model="ir.sequence">
            <field name="name">Account Code Sequence</field>
            <field name="code">accounting.account</field>
            <field name="prefix">ACC</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Commission Plan Sequence -->
        <record id="seq_commission_plan" model="ir.sequence">
            <field name="name">Commission Plan Sequence</field>
            <field name="code">accounting.commission.plan</field>
            <field name="prefix">CP</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Commission Settlement Sequence -->
        <record id="seq_commission_settlement" model="ir.sequence">
            <field name="name">Commission Settlement Sequence</field>
            <field name="code">accounting.commission.settlement</field>
            <field name="prefix">CS</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
